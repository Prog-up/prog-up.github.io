<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default(site.title) }}</title>
    <link rel="stylesheet" href="/assets/css/adwaita.css">
    <script src="/assets/js/app.js" defer></script>
</head>
<body>
    <header class="headerbar">
        <div class="headerbar-start">
            <span class="branding" style="font-weight: 600; padding: 0 0.5rem;">{{ site.name }}</span>
        </div>
        <div class="headerbar-center">
            <!-- Optional AdwViewSwitcher or title -->
            <span class="headerbar-title">Portfolio</span>
        </div>
        <div class="headerbar-end">
            <button commandfor="html-root" command="--toggle-theme" class="button flat icon-btn" aria-label="Toggle Theme" title="Toggle Theme">
                <span style="display:inline-flex; width:16px; height:16px;">{% include "icons/dark-mode-symbolic.svg" %}</span>
            </button>
        </div>
    </header>

    <main class="window-content">
        <div class="clamp">
            {{ content | safe }}
        </div>
    </main>
</body>
</html>
