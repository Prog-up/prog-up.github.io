---
layout: layout.njk
title: Enzo Juhel - Portfolio
---

<!-- AdwStatusPage pattern for hero -->
<div class="status-page">
  <img src="/assets/images/Enzo%20-%20Pro%20scare.jpg" alt="Enzo Juhel" class="avatar" style="object-fit: cover;">
  <h1 class="title">Enzo Juhel</h1>
  <p class="description dim-label">SecDevOps & AI Agent Architecture at EPITA</p>
  
  <div class="flex gap-2 justify-center mt-3">
    <a href="/assets/cv/CV%20-%20Enzo%20Juhel.pdf" target="_blank" class="button primary pill">View Résumé (PDF)</a>
    <a href="#contact" class="button pill">Contact Me</a>
  </div>
</div>

<div class="mt-4">
  <h2 class="section-title">Case Studies</h2>
  <!-- Boxed List Pattern -->
  <div class="boxed-list">
    {% for case in cases %}
    <!-- ActionRow Pattern -->
    <button class="list-row action-row" commandfor="case-modal-{{ case.slug }}" command="show-modal">
      <div class="action-row-content">
        <div class="action-row-title">{{ case.title }}</div>
        <div class="action-row-subtitle dim-label">{{ case.summary }}</div>
      </div>
      <div class="action-row-end">
        <span class="go-next-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/right-symbolic.svg" %}</span>
      </div>
    </button>
    {% endfor %}
  </div>
</div>

<div class="mt-4" id="contact">
  <h2 class="section-title">Contact</h2>
  <div class="boxed-list">
    <!-- Email -->
    <a href="mailto:{{ site.email }}" class="list-row action-row">
      <div class="action-row-start">
        <span class="contact-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/mail-unread-symbolic.svg" %}</span>
      </div>
      <div class="action-row-content">
        <div class="action-row-title">Email</div>
        <div class="action-row-subtitle dim-label">{{ site.email }}</div>
      </div>
    </a>
    
    <!-- Phone -->
    <a href="tel:{{ site.phone | replace(" ", "") }}" class="list-row action-row">
      <div class="action-row-start">
        <span class="contact-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/phone-right-facing-symbolic.svg" %}</span>
      </div>
      <div class="action-row-content">
        <div class="action-row-title">Phone</div>
        <div class="action-row-subtitle dim-label">{{ site.phone }}</div>
      </div>
    </a>
    
    <!-- LinkedIn -->
    <a href="{{ site.linkedin }}" target="_blank" class="list-row action-row">
      <div class="action-row-start">
        <span class="contact-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/meeting-symbolic.svg" %}</span>
      </div>
      <div class="action-row-content">
        <div class="action-row-title">LinkedIn</div>
        <div class="action-row-subtitle dim-label">Enzo Juhel</div>
      </div>
      <div class="action-row-end">
        <span class="go-next-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/external-link-symbolic.svg" %}</span>
      </div>
    </a>
    
    <!-- GitHub -->
    <a href="{{ site.github }}" target="_blank" class="list-row action-row">
      <div class="action-row-start">
        <span class="contact-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/appimagekit-github-desktop-symbolic.svg" %}</span>
      </div>
      <div class="action-row-content">
        <div class="action-row-title">GitHub</div>
        <div class="action-row-subtitle dim-label">Prog-up</div>
      </div>
      <div class="action-row-end">
        <span class="go-next-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/external-link-symbolic.svg" %}</span>
      </div>
    </a>
    
    <!-- Location -->
    <div class="list-row action-row" style="cursor: default; pointer-events: none;">
      <div class="action-row-start">
        <span class="contact-icon" style="display:inline-flex; width:16px; height:16px;">{% include "icons/map-marker-symbolic.svg" %}</span>
      </div>
      <div class="action-row-content">
        <div class="action-row-title">Location</div>
        <div class="action-row-subtitle dim-label">{{ site.location }}</div>
      </div>
    </div>
  </div>
</div>

<!-- Render all the dialogs here at the end -->
{% for case in cases %}
<dialog id="case-modal-{{ case.slug }}" class="adwaita-dialog">
  <div class="dialog-header headerbar">
    <div class="headerbar-start"></div>
    <div class="headerbar-center">
       <span class="headerbar-title">{{ case.title }}</span>
    </div>
    <div class="headerbar-end">
      <button commandfor="case-modal-{{ case.slug }}" command="close" class="button flat icon-btn" aria-label="Close">
        <span style="display:inline-flex; width:16px; height:16px;">{% include "icons/cross-small-symbolic.svg" %}</span>
      </button>
    </div>
  </div>
  <div class="dialog-content">

    {% set period = case.date | parseDate %}
    <div class="period-box-container mb-4">
      <div class="boxed-list period-box">
        <div class="action-row">
          <div class="action-row-content text-center">
            <div class="action-row-subtitle dim-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">Start</div>
            <div class="action-row-title">{{ period.start }}</div>
          </div>
        </div>
        <div class="period-divider"></div>
        <div class="action-row">
          <div class="action-row-content text-center">
            <div class="action-row-subtitle dim-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">End</div>
            <div class="action-row-title">{{ period.end }}</div>
          </div>
        </div>
      </div>
    </div>
    <p>{{ case.summary }}</p>
    <div class="case-study-content mt-3">
      {{ case.slug | renderMarkdown | safe }}
    </div>
  </div>
</dialog>
{% endfor %}
