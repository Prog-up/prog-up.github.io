---
layout: layout.njk
title: Enzo Juhel - Portfolio
---

<header class="hero-header mb-0">
  <h1>Enzo Juhel</h1>
  <p class="subtitle">SecDevOps & AI Agent Architecture at EPITA</p>
  <div class="flex gap-2">
    <a href="/assets/cv/CV%20-%20Enzo%20Juhel.pdf" target="_blank" class="button primary">View Résumé (PDF)</a>
    <a href="#contact" class="button">Contact Me</a>
  </div>
</header>

<h2>Case Studies</h2>
<div class="boxed-list">
  {% for case in cases %}
  <div class="boxed-row">
    <div class="row-header">
      <h3 class="row-title">{{ case.title }}</h3>
      <span class="row-subtitle">{{ case.date }}</span>
    </div>
    <div class="row-body">
      {{ case.summary }}
    </div>
    <div class="tags">
      {% for tag in case.tags %}
        <span class="tag">{{ tag }}</span>
      {% endfor %}
    </div>
    <div class="mt-2">
      <button commandfor="case-modal-{{ case.slug }}" command="show-modal" class="button">Read More</button>
    </div>
  </div>

  <dialog id="case-modal-{{ case.slug }}">
    <div class="dialog-header">
      <h3>{{ case.title }}</h3>
      <button commandfor="case-modal-{{ case.slug }}" command="close" class="button icon-btn" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="dialog-content">
      <p><strong>Timeline:</strong> {{ case.date }}</p>
      <p>{{ case.summary }}</p>
      <p><em>(Detailed case study writeup will be loaded here in the future from the case's asset folder)</em></p>
    </div>
    <div class="dialog-footer">
      <button commandfor="case-modal-{{ case.slug }}" command="close" class="button primary">Close</button>
    </div>
  </dialog>
  {% endfor %}
</div>

<h2 id="contact">Contact</h2>
<div class="boxed-list">
  <div class="boxed-row flex items-center gap-2">
    <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
    <div>
      <strong style="display:block">Email</strong>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
  <div class="boxed-row flex items-center gap-2">
    <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
    <div>
      <strong style="display:block">Phone</strong>
      <a href="tel:{{ site.phone | replace(" ", "") }}">{{ site.phone }}</a>
    </div>
  </div>
  <div class="boxed-row flex items-center gap-2">
    <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
    <div>
      <strong style="display:block">LinkedIn</strong>
      <a href="{{ site.linkedin }}" target="_blank">Enzo Juhel</a>
    </div>
  </div>
  <div class="boxed-row flex items-center gap-2">
    <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
    <div>
      <strong style="display:block">GitHub</strong>
      <a href="{{ site.github }}" target="_blank">Prog-up</a>
    </div>
  </div>
  <div class="boxed-row flex items-center gap-2">
    <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
    <div>
      <strong style="display:block">Location</strong>
      <span>{{ site.location }}</span>
    </div>
  </div>
</div>
